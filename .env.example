# Copy to .env.local for local dev, or set the same keys on Railway Variables.
# Production values also live in .env.production (loaded by Next.js on Railway).

# Admin login (used when seeding)
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=use-your-railway-secret

# Session secret — change if this repo is ever public
AUTH_SECRET=generate-a-long-random-secret

# Navi (cute AI assistant) — OpenAI-compatible. Optional: without a key Navi still
# answers from portal data using a local brain. Works with OpenAI, OpenRouter, Groq, etc.
# NAVI_API_KEY=sk-...
# OPENAI_API_KEY=sk-...
# NAVI_API_BASE=https://api.openai.com/v1
# NAVI_MODEL=gpt-4o-mini

# Business info
NEXT_PUBLIC_BUSINESS_NAME=NAVRIT
NEXT_PUBLIC_BUSINESS_TAGLINE=Turning Waste into Value.
NEXT_PUBLIC_OWNER_NAME=Nitin Gupta
NEXT_PUBLIC_PHONE=+91 84398-23083
NEXT_PUBLIC_WHATSAPP=918439823083
NEXT_PUBLIC_EMAIL=navrit.baheri@gmail.com
NEXT_PUBLIC_ADDRESS=Mohalla Tanda, Near Kesar Factory, Mundia Road, Baheri, Bareilly, Uttar Pradesh
NEXT_PUBLIC_GSTIN=09EWNPG4899C1ZY
NEXT_PUBLIC_MAPS_EMBED_URL=https://maps.google.com/maps?q=Mohalla%20Tanda%20Near%20Kesar%20Factory%20Mundia%20Road%20Baheri%20Bareilly&t=&z=15&ie=UTF8&iwloc=&output=embed
