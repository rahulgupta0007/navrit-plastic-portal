{
  "name": "plastic-portal",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "NAVRIT_SQLITE_MEMORY=1 next build",
