    "lint": "eslint .",
    "db:seed": "node --env-file=.env.local src/db/seed.mjs",
    "db:seed:prod": "node src/db/seed.mjs",
    "db:backup": "tsx scripts/db-backup.ts",
    "db:restore": "tsx scripts/db-restore.ts",
    "db:restore:list": "tsx scripts/db-restore.ts --list",
    "deploy:safe": "tsx scripts/deploy-safe.ts",
